{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": false,
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "foreground": "lightYellow",
          "style": "plain",
          "template": "{{ .UserName }}{{ if .HostName }}@{{ .HostName }}{{ end }}",
          "type": "session"
        },
        {
          "foreground": "cyan",
          "style": "plain",
          "template": " <#ffffff>in</> {{ .Path }}",
          "type": "path",
          "properties": {
            "style": "full"
          }
        },
        {
          "foreground": "#ff94df",
          "style": "plain",
          "template": " <#ffffff>on</> {{ .HEAD }}{{ if .Ahead }} ↑{{ .Ahead }}{{ end }}{{ if .Behind }} ↓{{ .Behind }}{{ end }}{{ if eq .Ahead 0 }}{{ if eq .Behind 0 }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}{{ end }}{{ end }}{{ if and (gt .Ahead 0) (gt .Behind 0) }} ↑↓{{ end }}",
          "type": "git",
          "properties": {
            "branch_icon": "<#ff94df><b> </b></>",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "foreground": "#6CC24A",
          "style": "plain",
          "type": "node"
        },
        {
          "foreground": "#F472B6",
          "style": "plain",
          "type": "bun"
        },
        {
          "foreground": "#70FFAF",
          "style": "plain",
          "type": "deno"
        },
        {
          "foreground": "#CC342D",
          "style": "plain",
          "type": "ruby"
        },
        {
          "foreground": "#FFD43B",
          "style": "plain",
          "template": " <#ffffff>via</>  {{ if .Venv }}{{ .Venv }} {{ end }}{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "type": "python",
          "properties": {
            "display_mode": "context",
            "fetch_virtual_env": true
          }
        },
        {
          "foreground": "#60B5CC",
          "style": "plain",
          "type": "elm"
        },
        {
          "foreground": "#A074C4",
          "style": "plain",
          "type": "elixir"
        },
        {
          "foreground": "#F05138",
          "style": "plain",
          "type": "swift"
        },
        {
          "foreground": "#00ADD8",
          "style": "plain",
          "type": "golang"
        },
        {
          "foreground": "#7A8CBF",
          "style": "plain",
          "type": "perl"
        },
        {
          "foreground": "#8892BF",
          "style": "plain",
          "type": "php"
        },
        {
          "foreground": "#DEA584",
          "style": "plain",
          "type": "rust"
        },
        {
          "foreground": "#B47FE0",
          "style": "plain",
          "type": "haskell"
        },
        {
          "foreground": "#DC322F",
          "style": "plain",
          "type": "scala"
        },
        {
          "foreground": "#7F52FF",
          "style": "plain",
          "type": "kotlin"
        },
        {
          "foreground": "#D97706",
          "style": "plain",
          "type": "java"
        },
        {
          "foreground": "#7AA2F7",
          "style": "plain",
          "type": "lua"
        },
        {
          "foreground": "#0175C2",
          "style": "plain",
          "type": "dart"
        },
        {
          "foreground": "#9558B2",
          "style": "plain",
          "type": "julia"
        },
        {
          "foreground": "#BE95FF",
          "style": "plain",
          "type": "crystal"
        },
        {
          "foreground": "#F7A41D",
          "style": "plain",
          "type": "zig"
        },
        {
          "foreground": "#A90533",
          "style": "plain",
          "type": "erlang"
        },
        {
          "foreground": "#FFAFF3",
          "style": "plain",
          "type": "gleam"
        },
        {
          "foreground": "#F28C28",
          "style": "plain",
          "type": "ocaml"
        },
        {
          "foreground": "#5597D0",
          "style": "plain",
          "type": "vlang"
        },
        {
          "foreground": "#A3BE8C",
          "style": "plain",
          "type": "purescript"
        },
        {
          "foreground": "#2496ED",
          "style": "plain",
          "type": "docker"
        },
        {
          "foreground": "#ffaf00",
          "style": "plain",
          "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}",
          "type": "aws",
          "properties": {
            "display_default": false
          }
        },
        {
          "foreground": "#4285F4",
          "style": "plain",
          "type": "gcloud"
        },
        {
          "foreground": "#0078D4",
          "style": "plain",
          "type": "az"
        },
        {
          "foreground": "#512BD4",
          "style": "plain",
          "type": "dotnet"
        },
        {
          "foreground": "#326CE5",
          "style": "plain",
          "type": "kubectl"
        },
        {
          "foreground": "#EE0000",
          "style": "plain",
          "type": "ansible"
        },
        {
          "foreground": "#844ae7",
          "style": "plain",
          "template": " tf:{{ .WorkspaceName }}",
          "type": "terraform",
          "properties": {
            "command": "terraform"
          }
        },
        {
          "foreground": "#8A3391",
          "style": "plain",
          "type": "pulumi"
        },
        {
          "foreground": "yellow",
          "style": "plain",
          "template": " took {{ .FormattedMs }}",
          "type": "executiontime",
          "properties": {
            "always_enabled": false,
            "threshold": 500,
            "style": "austin"
          }
        },
        {
          "foreground": "#EB6F92",
          "style": "plain",
          "type": "battery",
          "template": " {{ if and (not .Error) (lt .Percentage 25.0) }}{{ .Icon }}{{ .Percentage }}{{ end }}"
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "type": "prompt",
      "segments": [
        {
          "foreground": "red",
          "style": "plain",
          "template": "{{ if gt .Code 0 }}✘{{ .Code }} {{ end }}",
          "type": "status",
          "properties": {
            "always_enabled": false
          }
        },
        {
          "foreground": "lightGreen",
          "style": "plain",
          "template": "{{ if .Root }}#{{ else }}>{{ end }} ",
          "type": "text"
        }
      ]
    }
  ]
}
