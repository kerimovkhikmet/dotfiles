# ~/.blerc - ble.sh config, loaded on attach
# full option list: ~/.local/share/blesh/doc/ or https://akinomyoga.github.io/ble.sh/

# keymap - emacs is deliberate (2026-09-08): continuity with stock bash/omz;
# vi keymap = future switch (nvim/VSCodeVim parity argument noted)
bleopt default_keymap=emacs

# completion menu with descriptions
bleopt complete_menu_style=desc

# right prompt - took (>=500ms, spaceship exec_time parity) + clock at the far
# right (zsh RPROMPT parity). ble.sh renders rps1 natively - oh-my-posh's
# padded right block in PS1 is what ble.sh mismeasured (the >-to-cursor gap).
# $_omp_execution_time (ms, -1 when idle) is set by omp's PROMPT_COMMAND hook.
# true exit status, captured in a POSTEXEC hook: ble.sh's own trap handling
# resets $? before PROMPT_COMMAND runs on signal-killed commands (so omp's
# $_omp_status reads 0 there), but hooks run with the status still intact.
# The trailing return preserves $? for everything downstream.
function _ble-save-status { _BLE_LAST_STATUS=$?; return "$_BLE_LAST_STATUS"; }
blehook POSTEXEC+=_ble-save-status

# redundant with ✘N in the right prompt - disable ble.sh's own marker line
# (bleopt assigns only as NAME=VALUE; a bare name just prints)
bleopt exec_errexit_mark=

function _omp-ble-rps1 {
  local code=${_BLE_LAST_STATUS:-${_omp_status:-0}}
  if (( code != 0 )); then
    printf '\e[38;2;235;111;146m✘%s\e[0m  ' "$code"
  fi
  local t=${_omp_execution_time:--1}
  if (( t >= 500 )); then
    printf 'took %d.%03ds  ' $((t / 1000)) $((t % 1000))
  fi
  printf '\e[38;2;156;207;216m%s\e[0m' "$(date +%H:%M:%S)"
}
bleopt prompt_rps1='$(_omp-ble-rps1)'

# history - zsh-style prefix filter: Up/Down immediately cycle entries starting
# with the typed prefix (empty input cycles everything, like plain Up/Down).
# Implemented directly on ble.sh's history API - history-search always opens
# the interactive nsearch UI, which Up/Down must not do. The original prefix is
# remembered while the line is untouched, so repeated presses keep cycling the
# same set instead of narrowing to the full matched line.
function ble/widget/history-prefix-search {
  local dir=$1
  local cur=${_ble_edit_str::_ble_edit_ind} needle start
  local index count
  ble/history/get-index -v index
  ble/history/get-count -v count
  if [[ -n ${_ble_hist_prefix_active-} && $cur == "$_ble_hist_prefix_placed" ]]; then
    needle=$_ble_hist_prefix_needle
    start=$index
  else
    needle=$cur
    _ble_hist_prefix_needle=$needle
    if (( dir < 0 )); then
      start=$count
    else
      start=$index
    fi
  fi
  local i=$((start + dir)) entry
  while (( 0 <= i && i <= count )); do
    ble/history/get-entry -v entry "$i"
    if [[ $entry == "$needle"* ]]; then
      ble-edit/history/goto "$i" point=end
      _ble_hist_prefix_placed=$entry
      _ble_hist_prefix_active=1
      return 0
    fi
    ((i += dir))
  done
  ble/widget/.bell
}
function ble/widget/history-prefix-prev { ble/widget/history-prefix-search -1; }
function ble/widget/history-prefix-next { ble/widget/history-prefix-search +1; }
ble-bind -m emacs -f 'up'   'history-prefix-prev'
ble-bind -m emacs -f 'down' 'history-prefix-next'

# Rose Pine Moon palette (matches ghostty/kitty/wezterm themes)
# text e0def4 - muted 6e6a86 - subtle 908caa - love eb6f92 - gold f6c177
# rose ebbcba - pine 31748f - foam 9ccfd8 - iris c4a7e7 - highlight 403d52
ble-face -s syntax_default fg=#ebbcba
ble-face -s syntax_command fg=#c4a7e7
ble-face -s command_builtin fg=#9ccfd8
ble-face -s command_builtin_dot fg=#9ccfd8
ble-face -s command_alias fg=#ebbcba
ble-face -s command_function fg=#ebbcba
ble-face -s command_file fg=#c4a7e7
ble-face -s command_directory fg=#9ccfd8
# file-name candidates in the tab menu (filename_directory defaults to 256-color
# 33 = the bright blue); ble-face -s replaces the whole spec, dropping underline
ble-face -s filename_directory fg=#9ccfd8
ble-face -s filename_executable fg=#f6c177
ble-face -s filename_link fg=#c4a7e7
ble-face -s filename_directory_sticky fg=#908caa,bg=#403d52
ble-face -s filename_orphan fg=#eb6f92,bg=#403d52
ble-face -s command_keyword fg=#f6c177
ble-face -s syntax_error fg=#eb6f92,bg=#403d52
ble-face -s syntax_delimiter fg=#908caa
ble-face -s syntax_quoted fg=#31748f
ble-face -s syntax_quotation fg=#ebbcba
ble-face -s syntax_escape fg=#f6c177
ble-face -s syntax_expr fg=#ebbcba
ble-face -s syntax_function_name fg=#f6c177
ble-face -s syntax_glob fg=#ebbcba
ble-face -s syntax_param_expansion fg=#c4a7e7
ble-face -s syntax_varname fg=#9ccfd8
ble-face -s syntax_tilde fg=#908caa
ble-face -s syntax_comment fg=#6e6a86,it
ble-face -s syntax_document fg=#6e6a86
ble-face -s syntax_document_begin fg=#6e6a86
ble-face -s syntax_history_expansion fg=#f6c177
ble-face -s argument_option fg=#f6c177
ble-face -s argument_error fg=#eb6f92
ble-face -s auto_complete fg=#6e6a86,bg=none
ble-face -s menu_complete_selected fg=#e0def4,bg=#403d52
ble-face -s menu_complete_match fg=#f6c177
ble-face -s menu_desc_default fg=#6e6a86
ble-face -s menu_filter_input fg=#e0def4,bg=#403d52
ble-face -s menu_filter_fixed fg=#6e6a86
ble-face -s disabled fg=#6e6a86,bg=#403d52
