# global default identity - private file, seeded by install.sh (seed_identities)
# the per-directory includeIf blocks below override it
[include]
	path = ~/.config/git/identities/default

[init]
	defaultBranch = master

[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore
	autocrlf = input
	# global hooks: lint/format + commit-msg enforcement on every repo
	# (repos shipping their own .pre-commit-config.yaml use it instead)
	hooksPath = ~/.config/git/hooks

[credential]
	helper = os

[safe]
	directory = /opt/neovim

[pull]
	rebase = false

[fetch]
	prune = true
	pruneTags = false

[push]
	default = simple
	autoSetupRemote = true

[branch]
	autosetupmerge = true
	autosetuprebase = never

[color]
	ui = auto

[diff]
	colorMoved = zebra

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[commit]
	template = ~/.config/git/commit-template
	verbose = true

# per-directory identities - ~/Development/<host>/<owner>/<repo>
# broad patterns first, owner-specific overrides after (later include wins)
[includeIf "gitdir:~/Development/github.com/"]
	path = ~/.config/git/identities/github-personal

[includeIf "gitdir:~/Development/gitlab.com/"]
	path = ~/.config/git/identities/gitlab-personal

# extra accounts: copy a ~/.config/git/identities/*.template, fill it, wire it here
# work account on a public host - narrower pattern overrides the host-wide include above
#[includeIf "gitdir:~/Development/github.com/<org>/"]
#	path = ~/.config/git/identities/github-work
# work account on a company host
#[includeIf "gitdir:~/Development/company.github.com/"]
#	path = ~/.config/git/identities/company-work
