#!/bin/sh
# git-credential-os - cross-platform credential helper dispatcher for dotfiles
# - WSL (generic linux): cache --timeout 3600 (not Windows GCM)
# - macOS/Linux: GCM if available (git-credential-manager / manager-core), else cache
# Stow: bin/.local/bin/git-credential-os -> ~/.local/bin/git-credential-os
# git config: credential.helper = os  (resolves to git-credential-os via $PATH)
# Mixed SSH+HTTPS: SSH needs no helper; HTTPS uses this.

# WSL check - treat as generic linux-gnu, not Windows GCM
if grep -qi microsoft /proc/version 2>/dev/null; then
  exec git credential-cache --timeout=3600 "$@"
fi

# Try GCM - brew `git-credential-manager` (macOS/Linux) or legacy `manager-core`
if command -v git-credential-manager >/dev/null 2>&1; then
  exec git-credential-manager "$@"
fi
if command -v git-credential-manager-core >/dev/null 2>&1; then
  exec git-credential-manager-core "$@"
fi

# Fallback - cache (works everywhere, no libsecret needed)
exec git credential-cache --timeout=3600 "$@"
