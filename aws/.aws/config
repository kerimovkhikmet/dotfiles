# aws - Stow package aws/.aws/config -> ~/.aws/config (template, no secrets)
# Mixed SSH+HTTPS setup: this is stowed; ~/.aws/credentials stays private and is NOT tracked
# See: https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html
# After stow, configure credentials via: aws configure sso / aws configure / env vars
# Keep this file minimal and portable across macOS/Linux/WSL

[default]
# default region for aws cli and terraform AWS provider
region = eu-central-1
output = json

# Example SSO profile (uncomment and fill when needed):
# [profile dev]
# sso_start_url = https://my-sso.awsapps.com/start
# sso_region = eu-central-1
# sso_account_id = 123456789012
# sso_role_name = AdministratorAccess
# region = eu-central-1
# output = json

# Terraform can reuse this config via AWS provider:
# provider "aws" { region = "eu-central-1" }
